{
  "name": "monthly-expenses-android",
  "version": "1.0.0",
  "private": true,
  "description": "Android app for Monthly Expenses",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "android:init": "npm run prepare:web && npx cap add android",
    "android:sync": "npm run prepare:web && npx cap sync android",
    "android:debug-apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "html2canvas": "^1.4.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0"
  }
}
